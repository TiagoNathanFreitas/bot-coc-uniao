import os
import asyncio
import discord
from discord.ext import commands, tasks
import coc

# Carregar variáveis de ambiente do Render
DISCORD_TOKEN = os.getenv("DISCORD_TOKEN")
CHANNEL_ID = os.getenv("DISCORD_CHANNEL_ID")
CLAN_TAG = os.getenv("CLAN_TAG")
COC_EMAIL = os.getenv("COC_EMAIL")
COC_PASSWORD = os.getenv("COC_PASSWORD")

# Configurar Intenções do Discord
intents = discord.Intents.default()
intents.message_content = True

bot = commands.Bot(command_prefix="!", intents=intents)

# Cliente da API do Clash of Clans
coc_client = coc.login(COC_EMAIL, COC_PASSWORD)


async def get_pending_attacks():
    """Procura os ataques pendentes na guerra atual."""
    try:
        war = await coc_client.get_current_war(CLAN_TAG)
        if not war or war.state != "inWar":
            return None, "O clã não está atualmente em guerra."

        pending_members = []
        for member in war.members:
            # Verifica se o membro ainda tem ataques restantes
            attacks_used = len(member.attacks)
            if attacks_used < war.attacks_per_member:
                remaining = war.attacks_per_member - attacks_used
                pending_members.append(
                    {
                        "name": member.name,
                        "town_hall": member.town_hall,
                        "remaining": remaining,
                    }
                )

        # Ordenar por nível de Centro de Vila (CV)
        pending_members.sort(key=lambda x: x["town_hall"], reverse=True)
        return pending_members, None
    except Exception as e:
        return None, f"Erro ao aceder à API do Clash of Clans: {e}"


@bot.event
async def on_ready():
    print(f"Bot ligado com sucesso como {bot.user}")
    check_war_status.start()


@bot.command(name="guerra")
async def guerra_status(ctx):
    """Comando manual para verificar o estado da guerra."""
    pending, error = await get_pending_attacks()
    if error:
        await ctx.send(f"⚠️ {error}")
        return

    if not pending:
        await ctx.send("🎉 Excelente! Todos os ataques da guerra foram realizados.")
        return

    msg = "**⚔️ Relatório de Ataques Pendentes na Guerra ⚔️**\n\n"
    for m in pending:
        msg += f"• **{m['name']}** (CV {m['town_hall']}) - Falta(m) **{m['remaining']}** ataque(s)\n"

    await ctx.send(msg)


@bot.command(name="cobrar")
async def cobrar_ataques(ctx):
    """Comando para cobrar os membros que ainda não atacaram."""
    pending, error = await get_pending_attacks()
    if error:
        await ctx.send(f"⚠️ {error}")
        return

    if not pending:
        await ctx.send("Nenhum ataque pendente para cobrar!")
        return

    msg = "📢 **ATENÇÃO CLÃ - COBRANÇA DE GUERRA** 📢\n"
    msg += "Os seguintes membros ainda possuem ataques pendentes na guerra:\n\n"
    for m in pending:
        msg += f"🚨 **{m['name']}** (CV {m['town_hall']}) -> Restam **{m['remaining']}** ataque(s)!\n"

    msg += "\nPor favor, realizem os vossos ataques o mais rápido possível!"
    await ctx.send(msg)


@tasks.loop(hours=4)
async def check_war_status():
    """Tarefa automática para enviar avisos no canal do Discord."""
    if not CHANNEL_ID:
        return

    channel = bot.get_channel(int(CHANNEL_ID))
    if not channel:
        return

    pending, error = await get_pending_attacks()
    if error or not pending:
        return

    msg = "🔔 **Lembrete Automático de Guerra** 🔔\n"
    msg += "Ainda existem membros com ataques pendentes:\n"
    for m in pending:
        msg += f"• **{m['name']}** (CV {m['town_hall']}) - {m['remaining']} ataque(s) restante(s)\n"

    await channel.send(msg)


# Iniciar o Bot
if __name__ == "__main__":
    bot.run(DISCORD_TOKEN)
