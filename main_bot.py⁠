import os
import discord
from discord.ext import commands, tasks
import coc

DISCORD_TOKEN = os.getenv('DISCORD_TOKEN')
COC_EMAIL = os.getenv('COC_EMAIL')
COC_PASSWORD = os.getenv('COC_PASSWORD')
CLAN_TAG = os.getenv('CLAN_TAG', '#2YVY088R2')
DISCORD_CHANNEL_ID = int(os.getenv('DISCORD_CHANNEL_ID', '1380453139207159949'))

intents = discord.Intents.default()
intents.message_content = True
bot = commands.Bot(command_prefix='!', intents=intents)

coc_client = coc.Client()

@bot.event
async def on_ready():
    print(f'Bot ligado com sucesso como: {bot.user}')
    try:
        await coc_client.login(COC_EMAIL, COC_PASSWORD)
        print("Login na API do Clash of Clans efetuado com sucesso!")
    except Exception as e:
        print(f"Erro ao ligar à API do CoC: {e}")
    
    if not auto_war_check.is_running():
        auto_war_check.start()

async def get_war_status():
    try:
        war = await coc_client.get_current_war(CLAN_TAG)
        if not war or war.state != "inWar":
            return "O clã não está atualmente numa guerra ativa.", []

        pending_members = []
        for member in war.members:
            attacks_used = len(member.attacks)
            if attacks_used < war.attacks_per_member:
                attacks_left = war.attacks_per_member - attacks_used
                pending_members.append((member.name, member.town_hall, attacks_left))

        pending_members.sort(key=lambda x: x[1], reverse=True)
        return war, pending_members
    except Exception as e:
        return f"Erro ao procurar dados da guerra: {e}", []

@bot.command(name='guerra')
async def guerra(ctx):
    await ctx.send("🔍 A consultar estado da guerra no Clash of Clans...")
    result, pending = await get_war_status()
    
    if isinstance(result, str):
        await ctx.send(result)
        return

    msg = f"⚔️ **GUERRA ATIVA: {result.clan.name} vs {result.opponent.name}**\n"
    msg += f"⏳ **Tempo restante:** {result.time_left}\n\n"
    
    if not pending:
        msg += "🎉 Todos os membros já realizaram todos os ataques!"
    else:
        msg += "📋 **Membros com ataques pendentes (ordenados por CV):**\n"
        for name, th, left in pending:
            msg += f"• **{name}** (CV {th}) — {left} ataque(s) restante(s)\n"

    await ctx.send(msg)

@bot.command(name='cobrar')
async def cobrar(ctx):
    result, pending = await get_war_status()
    
    if isinstance(result, str) or not pending:
        await ctx.send("Não há ataques pendentes para cobrar no momento.")
        return

    msg = "🚨 **ATENÇÃO CLÃ UNIAO - COBRANÇA DE GUERRA** 🚨\n"
    msg += "Os seguintes membros ainda possuem ataques para realizar:\n\n"
    for name, th, left in pending:
        msg += f"⚠️ **{name}** (CV {th}) -> Faltam {left} ataque(s)\n"
    msg += "\nPor favor, façam os vossos ataques o quanto antes para garantirmos a vitória! ⚔️"

    await ctx.send(msg)

@tasks.loop(hours=4)
async def auto_war_check():
    channel = bot.get_channel(DISCORD_CHANNEL_ID)
    if not channel:
        return

    result, pending = await get_war_status()
    if not isinstance(result, str) and pending:
        msg = "📢 **LEMBRETE AUTOMÁTICO DE GUERRA**\n"
        msg += f"Restam ataques pendentes na guerra atual. Faltam {len(pending)} membro(s) atacar!"
        await channel.send(msg)

if __name__ == '__main__':
    bot.run(DISCORD_TOKEN)
