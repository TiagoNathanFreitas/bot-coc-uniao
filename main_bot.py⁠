import os
import asyncio
import discord
from discord.ext import commands
import coc
from aiohttp import web

# 1. Servidor Web Falso para o Render (Plano Free)
async def handle(request):
    return web.Response(text="Bot do Clash de Clans ativo!")

async def start_web_server():
    app = web.Application()
    app.router.add_get('/', handle)
    runner = web.AppRunner(app)
    await runner.setup()
    port = int(os.environ.get("PORT", 10000))
    site = web.TCPSite(runner, '0.0.0.0', port)
    await site.start()

# 2. Variáveis de Ambiente
DISCORD_TOKEN = os.getenv("DISCORD_TOKEN")
CHANNEL_ID = os.getenv("DISCORD_CHANNEL_ID")
CLAN_TAG = os.getenv("CLAN_TAG")
COC_EMAIL = os.getenv("COC_EMAIL")
COC_PASSWORD = os.getenv("COC_PASSWORD")

# Configuração do Bot Discord
intents = discord.Intents.default()
intents.message_content = True
bot = commands.Bot(command_prefix="!", intents=intents)

# Cliente da API do Clash of Clans
coc_client = coc.Client()

@bot.event
async def on_ready():
    print(f'Bot ligado com sucesso como {bot.user}')

async def main():
    # Inicia o servidor HTTP para manter o Render ativo
    await start_web_server()

    # Login na API do Clash of Clans
    if COC_EMAIL and COC_PASSWORD:
        try:
            await coc_client.login(COC_EMAIL, COC_PASSWORD)
            print("Autenticado na API do Clash of Clans com sucesso!")
        except Exception as e:
            print(f"Erro ao ligar à API do CoC: {e}")

    # Inicia o Bot do Discord
    if DISCORD_TOKEN:
        await bot.start(DISCORD_TOKEN)

if __name__ == "__main__":
    asyncio.run(main())
