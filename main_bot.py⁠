import os
import asyncio
import traceback
import discord
from discord.ext import commands
import coc
from aiohttp import web

# 1. Servidor Web Falso para manter o Render Free ativo
async def handle(request):
    return web.Response(text="Bot do Clash de Clans ativo!")

async def start_web_server():
    app = web.Application()
    app.router.add_get('/', handle)
    runner = web.AppRunner(app)
    await runner.setup()
    port = int(os.environ.get("PORT", 10000))
    site = web.TCPSite(runner, '0.0.0.0', port)
    await site.start()
    print(f"Servidor web falso a correr na porta {port}")

# 2. Leitura das Variáveis de Ambiente
DISCORD_TOKEN = os.getenv("DISCORD_TOKEN")
CHANNEL_ID = os.getenv("DISCORD_CHANNEL_ID")
CLAN_TAG = os.getenv("CLAN_TAG")
COC_EMAIL = os.getenv("COC_EMAIL")
COC_PASSWORD = os.getenv("COC_PASSWORD")

# Configuração do Bot Discord
intents = discord.Intents.default()
intents.message_content = True
bot = commands.Bot(command_prefix="!", intents=intents)

@bot.event
async def on_ready():
    print(f'Bot ligado com sucesso como {bot.user}')

# COMANDO DE TESTE (!ping)
@bot.command()
async def ping(ctx):
    await ctx.send("🏓 **Pong! O Bot do Clan União está 100% online e funcional!**")

async def main():
    try:
        # Garante que existe um event loop ativo
        try:
            loop = asyncio.get_running_loop()
        except RuntimeError:
            loop = asyncio.new_event_loop()
            asyncio.set_event_loop(loop)

        # Inicia o servidor HTTP para o Render
        await start_web_server()

        # Tenta ligar à API do CoC (sem derrubar o bot caso falhe)
        try:
            coc_client = coc.Client(loop=loop)
            if COC_EMAIL and COC_PASSWORD:
                await coc_client.login(COC_EMAIL, COC_PASSWORD)
                print("Autenticado na API do Clash of Clans com sucesso!")
        except Exception as e:
            print(f"AVISO: Falha na API do CoC: {e}")

        # Inicia o Bot do Discord
        if DISCORD_TOKEN:
            print("A iniciar o bot do Discord...")
            await bot.start(DISCORD_TOKEN)
        else:
            print("ERRO: DISCORD_TOKEN não encontrado nas variáveis de ambiente!")

    except Exception as e:
        print("--- ERRO CRITICO NO MAIN ---")
        traceback.print_exc()

if __name__ == "__main__":
    asyncio.run(main())
